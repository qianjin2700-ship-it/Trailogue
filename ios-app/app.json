{
  "expo": {
    "name": "Trailogue",
    "owner": "hardworkgirls-team",
    "slug": "trailogue",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trailogue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.qianjin2700.trailogue",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trailogue uses photos you select to add them to your trip."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aef33182-1a9a-4807-83a0-e5b2d2096654"
      }
    }
  }
}
