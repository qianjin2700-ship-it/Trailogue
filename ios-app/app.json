{
  "expo": {
    "name": "Trailogue",
    "slug": "trailogue",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trailogue",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.qianjin2700.trailogue",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
