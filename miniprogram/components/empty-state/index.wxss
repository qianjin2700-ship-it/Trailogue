/* components/empty-state/index.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.text {
  font-size: 30rpx;
  color: var(--color-text-hint);
  text-align: center;
  margin-bottom: 32rpx;
}

.action-btn {
  min-width: 240rpx;
}
