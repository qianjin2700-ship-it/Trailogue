/* pages/share/index.wxss — 分享海报页 */
.page-share {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg, #f6f6f6);
}

.poster-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 48rpx;
}

.poster-image {
  width: 100%;
  max-width: 620rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  background: #ffffff;
}

.poster-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #eeeeee;
  border-top-color: var(--color-primary, #4a7c59);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.placeholder-text {
  font-size: 28rpx;
  color: var(--color-text-secondary, #888888);
}

.error .placeholder-text {
  color: var(--color-danger, #d64545);
  margin-bottom: 32rpx;
}

.retry-btn {
  margin: 0;
  min-width: 200rpx;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.action-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
}

/* 离屏海报画布：移出可视区但保持可绘制 */
.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 375px;
  height: 600px;
}
