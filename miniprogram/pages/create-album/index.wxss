/* pages/create-album/index.wxss */
.page-create-album {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.form-section {
  padding: 32rpx;
}

.field {
  margin-bottom: 32rpx;
  position: relative;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.required {
  color: var(--color-danger);
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 24rpx;
  background: var(--color-bg);
  border-radius: 12rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.counter {
  position: absolute;
  right: 8rpx;
  bottom: -28rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.style-item {
  padding: 16rpx 32rpx;
  background: var(--color-bg);
  border-radius: 32rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.style-item.active {
  background: var(--color-primary);
  color: #fff;
}

/* 带说明文字的选项（篇幅/编排） */
.style-item-main {
  font-size: 28rpx;
  line-height: 1.4;
}

.style-item-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--color-text-hint);
}

.style-item.active .style-item-hint {
  color: rgba(255, 255, 255, 0.8);
}

.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}
