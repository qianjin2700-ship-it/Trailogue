/* pages/photo-review/index.wxss */
.page-photo-review {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg, #f6f6f6);
}

.summary-bar {
  position: sticky;
  top: 0;
  display: flex;
  gap: 32rpx;
  padding: 20rpx 32rpx;
  background: var(--color-card, #ffffff);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.summary-item {
  font-size: 26rpx;
  font-weight: 500;
}

.summary-item.high { color: var(--color-success, #4a7c59); }
.summary-item.low { color: var(--color-warning, #e8a87c); }
.summary-item.unknown { color: var(--color-text-hint, #b0b0b0); }

/* EXIF 自动解析进行中提示条 */
.meta-processing-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 120rpx 14rpx 32rpx;
  background: rgba(74, 144, 217, 0.08);
  font-size: 24rpx;
  color: #4a90d9;
}

.meta-processing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4a90d9;
  animation: meta-pulse 1.2s ease-in-out infinite;
}

@keyframes meta-pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.meta-stuck-hint {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #e64340;
}

.meta-close {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--color-text-secondary, #666666);
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 8rpx;
}

.photo-scroll {
  flex: 1;
  overflow: hidden;
}

.photo-list {
  padding: 16rpx 0 160rpx;
}

.photo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin: 12rpx 16rpx;
  background: var(--color-card, #ffffff);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #eee;
}

.photo-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.photo-time {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text, #2c2c2c);
}

.photo-location {
  font-size: 24rpx;
  color: var(--color-text-secondary, #888888);
}

.badges {
  display: flex;
  gap: 8rpx;
  margin-top: 4rpx;
}

.edit-hint {
  font-size: 22rpx;
  color: var(--color-primary, #4a7c59);
  padding: 6rpx 14rpx;
  background: rgba(74, 124, 89, 0.08);
  border-radius: 8rpx;
}

.row-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.delete-hint {
  font-size: 22rpx;
  color: #e64340;
  padding: 6rpx 14rpx;
  background: rgba(230, 67, 64, 0.08);
  border-radius: 8rpx;
}

/* 重复照片提示条 */
.dup-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 16rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(230, 67, 64, 0.06);
  border: 1rpx solid rgba(230, 67, 64, 0.25);
  border-radius: 12rpx;
}

.dup-text {
  font-size: 24rpx;
  color: #c04541;
}

.dup-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: #e64340;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

/* 行内重复徽标 */
.dup-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: #e64340;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  color: var(--color-text-hint, #b0b0b0);
  font-size: 30rpx;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 80rpx;
  color: var(--color-text-hint, #b0b0b0);
}

.confirm-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: var(--color-card, #ffffff);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 20;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background: var(--color-primary, #4a7c59);
  color: #ffffff;
}

.btn-primary::after {
  border: none;
}

.btn-disabled {
  opacity: 0.6;
}

/* 编辑面板 */
.edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.edit-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  background: var(--color-card, #ffffff);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border, #ededed);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 28rpx;
  color: var(--color-text-secondary, #888888);
  padding: 8rpx;
}

.sheet-body {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.sheet-thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  background: #eee;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text, #2c2c2c);
  margin-bottom: 12rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row picker {
  flex: 1;
}

.picker-value {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-bg, #f6f6f6);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--color-text, #2c2c2c);
}

.picker-value.placeholder {
  color: var(--color-text-hint, #b0b0b0);
}

.form-input {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg, #f6f6f6);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: var(--color-text, #2c2c2c);
}

.form-input:last-child {
  margin-bottom: 0;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.switch-row .form-label {
  margin-bottom: 0;
}

.form-tip {
  font-size: 22rpx;
  color: var(--color-text-hint, #b0b0b0);
  line-height: 1.6;
  padding: 8rpx 0 24rpx;
}

.sheet-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-border, #ededed);
  background: var(--color-card, #ffffff);
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
