{
    "include":  [
                    "*.ts"
                ],
    "exclude":  [
                    "node_modules"
                ],
    "compilerOptions":  {
                            "outDir":  "./",
                            "resolveJsonModule":  true,
                            "moduleResolution":  "Node",
                            "strict":  false,
                            "target":  "ES2020",
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "module":  "CommonJS",
                            "rootDir":  "./",
                            "sourceMap":  false
                        }
}
