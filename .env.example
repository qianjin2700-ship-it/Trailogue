# Trailogue local backend configuration. Copy to .env for local development only.
# Never commit real credentials. Deployed values come from the platform's secret environment.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trailogue:trailogue_local@localhost:5432/trailogue
APP_BASE_URL=http://localhost:3000
APPLE_BUNDLE_ID=com.qianjin2700.trailogue
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET=trailogue-photos-local
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key
R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-key
R2_UPLOAD_URL_TTL_SECONDS=300
R2_READ_URL_TTL_SECONDS=600
PHOTO_MAX_BYTES=15728640
DEEPSEEK_API_KEY=replace-with-server-side-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Docker Compose local-only PostgreSQL values.
POSTGRES_DB=trailogue
POSTGRES_USER=trailogue
POSTGRES_PASSWORD=trailogue_local
