# ============================================================
# 旅迹成书 · 环境变量模板
# ============================================================
# 本项目的「环境变量」不是本地 .env 文件，而是配置在
# 微信云开发控制台 → 云函数 → 函数配置 → 环境变量 里的键值对。
# 本文件仅用于「列出需要配置哪些变量名」，真实值严禁提交到 Git。
#
# 复制本文件为 .env / .env.local 仅作本地备忘用（已被 .gitignore 忽略），
# 实际生效值仍需在云开发控制台逐个云函数上配置。
# ============================================================

# ---- internal-generateStory（AI 生成故事）----
# TokenHub（腾讯混元 MaaS）API Key，用于调用视觉/文本大模型
TOKENHUB_API_KEY=
# 模型名
MODEL_NAME=hy-vision-2.0-instruct
# 模型服务端点（代码有默认值 https://tokenhub.tencentmaas.com，可留空）
MODEL_ENDPOINT=https://tokenhub.tencentmaas.com

# ---- internal-processMeta（EXIF 解析 + 逆地址解析）----
# 腾讯位置服务 Key（逆地址解析用；留空则只存坐标、跳过地名解析）
TENCENT_LBS_KEY=

# ---- share（生成分享小程序码）----
# 小程序 AppID / AppSecret（用于 HTTP 降级获取 access_token）
WX_APP_ID=
WX_APP_SECRET=

# ---- 以下仅 scripts/migrate/*.js 脚本使用，云函数代码不读取 ----
# 腾讯云 API 凭证（批量配置云函数环境变量的脚本用）
TCB_SID=
TCB_SKEY=

# ---- 代码中读取环境变量的完整清单（来自源码扫描）----
# MODEL_ENDPOINT      → cloudfunctions/internal-generateStory/index.ts
# MODEL_NAME          → cloudfunctions/internal-generateStory/index.ts
# TOKENHUB_API_KEY    → cloudfunctions/internal-generateStory/index.ts
# TENCENT_LBS_KEY     → cloudfunctions/internal-processMeta/index.ts
# WX_APP_ID           → cloudfunctions/share/index.ts
# WX_APP_SECRET       → cloudfunctions/share/index.ts
